<UserControl x:Class="PetWalk.Views.RegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F5F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="10" Padding="40"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="450" Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.2" ShadowDepth="5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="🐾 PetWalk" FontSize="32" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,10"
                               Foreground="#4CAF50"/>
                    <TextBlock Text="Create your account" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,0,0,30"
                               Foreground="Gray"/>

                    <TextBlock Text="I am a:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <RadioButton Content="Dog Owner" IsChecked="{Binding IsOwner}"
                                     Margin="0,0,20,0" FontSize="14"/>
                        <RadioButton Content="Dog Walker" IsChecked="{Binding IsWalker}"
                                     FontSize="14"/>
                    </StackPanel>

                    <TextBlock Text="First Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="Last Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="Phone" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10" FontSize="14" Margin="0,0,0,15"/>

                    <!-- Walker fields - visible only when Walker is selected -->
                    <StackPanel x:Name="WalkerFields">
                        <TextBlock Text="Location" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10" FontSize="14" Margin="0,0,0,10"/>

                        <TextBlock Text="Hourly Rate ($)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding HourlyRate, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10" FontSize="14" Margin="0,0,0,15"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                               FontSize="12" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding SuccessMessage}" Foreground="Green"
                               FontSize="12" Margin="0,0,0,10"/>

                    <Button Content="Register" Command="{Binding RegisterCommand}"
                            Background="#4CAF50" Foreground="White"
                            FontSize="16" FontWeight="Bold"
                            Padding="15,10" Margin="0,0,0,15"
                            Cursor="Hand"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Already have an account? " Foreground="Gray"/>
                        <TextBlock Text="Login" Foreground="#4CAF50"
                                   Cursor="Hand" FontWeight="SemiBold">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding GoToLoginCommand}"
                                              MouseAction="LeftClick"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>