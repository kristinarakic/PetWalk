<UserControl x:Class="PetWalk.Views.WalkerDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="15,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WelcomeMessage}" Foreground="White"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding RatingDisplay}" Foreground="White"
                               FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox Content="Available" IsChecked="{Binding IsAvailable}"
                              Foreground="White" Margin="0,0,15,0"/>
                    <Button Content="Logout" Command="{Binding LogoutCommand}"
                            Background="#1976D2" Foreground="White" Padding="15,5"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="15">

            <!-- Tab: Pending Requests -->
            <TabItem Header="📬 Pending Requests">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding PendingWalks}"
                              SelectedItem="{Binding SelectedPendingWalk}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding ScheduledDate, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner.FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Dog" Binding="{Binding Dog.Name}" Width="*"/>
                            <DataGridTextColumn Header="Duration (min)" Binding="{Binding Duration}" Width="100"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Accept" Command="{Binding AcceptWalkCommand}"
                                Background="#4CAF50" Foreground="White"
                                Padding="20,8" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Decline" Command="{Binding DeclineWalkCommand}"
                                Background="#F44336" Foreground="White"
                                Padding="20,8" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab: Walk History -->
            <TabItem Header="📋 Walk History">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding WalkHistory}"
                              SelectedItem="{Binding SelectedHistoryWalk}"
                              AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding ScheduledDate, StringFormat=dd.MM.yyyy HH:mm}" Width="150"/>
                            <DataGridTextColumn Header="Owner" Binding="{Binding Owner.FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Dog" Binding="{Binding Dog.Name}" Width="*"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Start Walk" Command="{Binding StartWalkCommand}"
                                Background="#FF9800" Foreground="White"
                                Padding="20,8" Margin="0,0,10,0" Cursor="Hand"/>
                        <Button Content="Complete Walk" Command="{Binding CompleteWalkCommand}"
                                Background="#4CAF50" Foreground="White"
                                Padding="20,8" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab: My Availability -->
            <TabItem Header="🕐 My Availability">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid Grid.Column="0" ItemsSource="{Binding AvailabilitySlots}"
                  SelectedItem="{Binding SelectedSlot}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Margin="0,0,15,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Day" Binding="{Binding Date.DayOfWeek}" Width="100"/>
                            <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat=hh\\:mm}" Width="80"/>
                            <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat=hh\\:mm}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Background="White" CornerRadius="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Add Time Slot" FontSize="16" FontWeight="Bold"
                           Margin="0,0,0,15"/>

                            <TextBlock Text="Date" Margin="0,0,0,3"/>
                            <DatePicker SelectedDate="{Binding SlotDate}"
                            DisplayDateStart="{x:Static sys:DateTime.Now}"
                            Padding="8" Margin="0,0,0,10"
                            xmlns:sys="clr-namespace:System;assembly=mscorlib"/>

                            <TextBlock Text="Start Time (HH:mm)" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" Margin="0,0,0,10"/>

                            <TextBlock Text="End Time (HH:mm)" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8" Margin="0,0,0,15"/>

                            <Button Content="Add Slot" Command="{Binding AddSlotCommand}"
                        Background="#4CAF50" Foreground="White"
                        Padding="10,8" Margin="0,0,0,5" Cursor="Hand"/>
                            <Button Content="Remove Selected" Command="{Binding RemoveSlotCommand}"
                        Background="#F44336" Foreground="White"
                        Padding="10,8" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab: Export & Reports -->
            <TabItem Header="📊 Export">
                <StackPanel Margin="15" HorizontalAlignment="Left" Width="400">
                    <TextBlock Text="Export &amp; Reports" FontSize="18" FontWeight="Bold"
                               Margin="0,0,0,20"/>

                    <Button Content="Export to JSON" Command="{Binding ExportJsonCommand}"
                            Background="#2196F3" Foreground="White"
                            Padding="15,10" Margin="0,0,0,10" Cursor="Hand"/>

                    <Button Content="Export to XML" Command="{Binding ExportXmlCommand}"
                            Background="#2196F3" Foreground="White"
                            Padding="15,10" Margin="0,0,0,10" Cursor="Hand"/>

                    <Button Content="Generate Report" Command="{Binding GenerateReportCommand}"
                            Background="#9C27B0" Foreground="White"
                            Padding="15,10" Cursor="Hand"/>
                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#E8E8E8" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="Gray"/>
        </Border>
    </Grid>
</UserControl>